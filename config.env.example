# Existing Lima QEMU x86_64 instance.
LIMA_INSTANCE=linux

# Optional. Leave these empty for the first-run Wi-Fi selector.
WIFI_SSID=
WIFI_SECURITY=

# Optional. Leave empty to prompt for an IPv4 address or CIDR.
TARGET_CIDR=

# Optional HTTPS health check after connecting.
TARGET_URL=

# USB Wi-Fi adapter identifiers. Defaults are for Alfa AWUS1900 / RTL8814AU.
USB_VENDOR_ID=0x0bda
USB_PRODUCT_ID=0x8813

# UDP port forwarded by Lima from macOS to guest WireGuard.
WG_LISTEN_PORT=51820

# gui uses a macOS authorization dialog; sudo uses the terminal prompt.
ADMIN_MODE=gui

# Set automatically to 1 when manually entering a hidden SSID.
SKIP_SSID_SCAN=0

# Keep this at 1 to release the USB adapter whenever the tunnel is stopped.
STOP_VM_ON_DOWN=1
